# Build-time configuration. Copy to .env.local for development.
#
# None of these are secrets — every client holds them — but they are injected
# rather than committed so pointing at staging is a build variable, not a
# source edit somebody forgets to revert (TRD-CICD-006).

VITE_NAKAMA_HOST=127.0.0.1
VITE_NAKAMA_PORT=7350
VITE_NAKAMA_SERVER_KEY=defaultkey
VITE_NAKAMA_USE_SSL=false
VITE_VERIFIER_URL=http://127.0.0.1:8787
VITE_THIRDWEB_CLIENT_ID=
VITE_BUILD_VERSION=dev
